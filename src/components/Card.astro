---
/**
 * A sheet of paper: no border, a soft zero-blur offset shadow. With `href` the
 * whole card is one link, is taped on slightly crooked, and straightens and
 * lifts on hover (press physics); without it the card is static.
 * `tape` adds a strip of masking tape; it defaults to on for linked cards.
 */
type Tone = 'surface' | 'cream' | 'yellow' | 'blue' | 'coral';

interface Props {
  href?: string;
  tone?: Tone;
  as?: 'article' | 'div' | 'section' | 'li';
  tape?: boolean;
  class?: string;
}

const { href, tone = 'surface', as: Tag = 'article', tape, class: className } = Astro.props;
const classes = [
  'card',
  `card--${tone}`,
  { 'card--link press': href, tape: tape ?? Boolean(href) },
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes}>
      <slot />
    </a>
  ) : (
    <Tag class:list={classes}>
      <slot />
    </Tag>
  )
}

<style>
  .card {
    position: relative;
    display: block;
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: var(--_bg);
    color: var(--_fg);
    box-shadow: var(--_shadow, var(--shadow-rest));
  }

  .card--link {
    /* Picked up straight, with a taller lift than a button. */
    --lift-x: 0px;
    --lift: -6px;
    --tilt: 0deg;
    --rest-tilt: -0.8deg;
    text-decoration: none;
    transition-duration: 220ms;
  }

  .card--surface {
    --_bg: var(--color-surface);
    --_fg: var(--color-ink);
  }

  /* Same paper as the page: needs an outline to read as a separate sheet. */
  .card--cream {
    --_bg: var(--color-bg);
    --_fg: var(--color-ink);
    outline: var(--border-thin);
    outline-offset: -1px;
  }

  .card--yellow {
    --_bg: var(--color-sticky);
    --_fg: var(--color-ink);
  }

  .card--coral {
    --_bg: var(--color-coral-soft);
    --_fg: var(--color-ink);
  }

  .card--blue {
    --_bg: var(--color-blueprint);
    --_fg: var(--color-white);
    background-image:
      linear-gradient(var(--color-blueprint-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-blueprint-line) 1px, transparent 1px);
    background-size: var(--paper-grid) var(--paper-grid);
  }

  /* Body copy inside coloured cards inherits the card's foreground for contrast. */
  .card--coral :global(p),
  .card--blue :global(p) {
    color: inherit;
  }
</style>
