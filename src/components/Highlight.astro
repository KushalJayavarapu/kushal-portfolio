---
/**
 * Marks a key word or phrase with a coral marker underline (the notebook's
 * signature emphasis). The stroke is a Scribble, so it draws itself in.
 * `tone` and `animate` are kept from the previous block-highlight API so
 * existing pages need no changes; both tones now render the same.
 */
import Scribble from './Scribble.astro';

interface Props {
  tone?: 'white' | 'ink';
  animate?: boolean;
}
---

<span class="highlight"><slot /><Scribble shape="underline" class="highlight__mark" /></span>

<style>
  .highlight {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  .highlight :global(.highlight__mark) {
    position: absolute;
    left: -3%;
    bottom: -0.16em;
    width: 106%;
    height: 0.36em;
    pointer-events: none;
  }
</style>
