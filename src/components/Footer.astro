---
import { SITE, SOCIAL } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="mono">&copy; {year} {SITE.name}</p>
    <ul class="site-footer__links">
      <li><a class="mono" href={SOCIAL.github} rel="me">GitHub</a></li>
      <li><a class="mono" href={SOCIAL.linkedin} rel="me">LinkedIn</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    border-top: var(--border);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-5);
  }

  .site-footer p {
    color: var(--color-ink);
  }

  .site-footer__links {
    display: flex;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
</style>
