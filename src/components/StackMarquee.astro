---
/**
 * Motion catalogue #6: a continuous strip of tools, each on a piece of masking tape.
 * CSS only. The list is rendered twice so the loop is seamless; the second copy
 * is aria-hidden. Pauses on hover/focus and (via the reveal script in
 * BaseLayout) while offscreen. Under reduced motion it is a static wrapped list.
 */
interface Props {
  items: readonly string[];
  /** Accessible name for the region. */
  label: string;
  /** Small visible heading above the strip. */
  heading: string;
}

const { items, label, heading } = Astro.props;
---

<section class="marquee" aria-label={label} data-marquee>
  <p class="container marquee__label mono">{heading}</p>
  <div class="marquee__track">
    {
      [false, true].map((copy) => (
        <ul class="marquee__list" role="list" aria-hidden={copy ? 'true' : undefined}>
          {items.map((item) => (
            <li class="mono">{item}</li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    padding-block: var(--space-2) var(--space-3);
  }

  .marquee__label {
    margin-bottom: var(--space-2);
    max-width: var(--container-max);
    color: var(--color-ink-soft);
  }

  .marquee__track {
    display: flex;
    width: max-content;
  }

  .marquee__list {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-2) var(--space-4) var(--space-2) 0;
    list-style: none;
    white-space: nowrap;
  }

  /* Each tool is a torn strip of masking tape, stuck on at a slight angle. */
  .marquee__list li {
    padding: 6px 14px;
    background: var(--color-tape);
    color: var(--color-ink);
  }

  .marquee__list li:nth-child(3n) {
    transform: rotate(-1.5deg);
  }

  .marquee__list li:nth-child(3n + 1) {
    transform: rotate(1deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee__track {
      animation: marquee-slide 48s linear infinite;
    }

    .marquee:hover .marquee__track,
    .marquee:focus-within .marquee__track,
    .marquee.is-paused .marquee__track {
      animation-play-state: paused;
    }
  }

  /* Each copy is exactly half the track, so -50% lands on an identical frame. */
  @keyframes marquee-slide {
    to {
      transform: translateX(-50%);
    }
  }

  /* Reduced motion: one static, wrapped list. */
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      width: auto;
    }

    .marquee__list {
      flex-wrap: wrap;
      padding-inline: var(--container-pad);
    }

    .marquee__list[aria-hidden='true'] {
      display: none;
    }
  }
</style>
