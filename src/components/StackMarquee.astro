---
/**
 * Motion catalogue #6: a continuous ticker of tool tags in a bordered band.
 * CSS only. The list is rendered twice so the loop is seamless; the second copy
 * is aria-hidden. Pauses on hover/focus and (via the reveal script in
 * BaseLayout) while offscreen. Under reduced motion it is a static wrapped list.
 */
import Tag from './Tag.astro';

interface Props {
  items: readonly string[];
  label: string;
}

const { items, label } = Astro.props;
---

<section class="marquee" aria-label={label} data-marquee>
  <div class="marquee__track">
    {
      [false, true].map((copy) => (
        <ul class="marquee__list" role="list" aria-hidden={copy ? 'true' : undefined}>
          {items.map((item, i) => (
            <li>
              <Tag tone={i % 4 === 0 ? 'yellow' : 'cream'}>{item}</Tag>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    border-block: var(--border);
    background: var(--color-surface);
  }

  .marquee__track {
    display: flex;
    width: max-content;
  }

  .marquee__list {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    list-style: none;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee__track {
      animation: marquee-slide 40s linear infinite;
    }

    .marquee:hover .marquee__track,
    .marquee:focus-within .marquee__track,
    .marquee.is-paused .marquee__track {
      animation-play-state: paused;
    }
  }

  /* Each copy is exactly half the track, so -50% lands on an identical frame. */
  @keyframes marquee-slide {
    to {
      transform: translateX(-50%);
    }
  }

  /* Reduced motion: one static, wrapped, centred list. */
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      width: auto;
    }

    .marquee__list {
      flex-wrap: wrap;
      justify-content: center;
      padding-inline: var(--container-pad);
    }

    .marquee__list[aria-hidden='true'] {
      display: none;
    }
  }
</style>
