---
/**
 * Per-page <head> metadata: title, description, canonical URL, Open Graph,
 * Twitter card and JSON-LD. BaseLayout renders it; pages set it through
 * BaseLayout's props rather than using this component directly.
 *
 * - Absolute URLs come from `site` in astro.config.mjs (Astro.site).
 * - The home page gets Person + WebSite JSON-LD automatically.
 * - Passing `article` marks the page as a blog post: og:type "article",
 *   article:* tags and BlogPosting JSON-LD.
 */
import { SITE } from '../config/site';
import {
  blogPostingSchema,
  graph,
  personSchema,
  websiteSchema,
  type ArticleMeta,
} from '../lib/structured-data';

export interface Props {
  /** Page title without the site name; omit on the home page. */
  title?: string;
  description?: string;
  /** Social preview image: a path under public/ (or absolute URL), 1200x630 PNG/JPG. */
  image?: string;
  imageAlt?: string;
  /** Blog posts only. */
  article?: ArticleMeta;
  /** Keep the page out of search results. Also add it to the sitemap `filter` in astro.config.mjs. */
  noindex?: boolean;
}

const DEFAULT_IMAGE = '/og/default.png';
const DEFAULT_IMAGE_ALT = `${SITE.name}: ${SITE.description}`;

const {
  title,
  description = SITE.description,
  image = DEFAULT_IMAGE,
  imageAlt = image === DEFAULT_IMAGE ? DEFAULT_IMAGE_ALT : (title ?? SITE.name),
  article,
  noindex = false,
} = Astro.props;

// `site` is always set in astro.config.mjs; the fallback only keeps types honest.
const site = Astro.site ?? new URL(Astro.url.origin);
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
const isHome = Astro.url.pathname === '/';

const jsonLd = article
  ? graph([
      blogPostingSchema({
        site,
        url: canonical,
        title: title ?? SITE.name,
        description,
        image: imageUrl,
        article,
      }),
      personSchema(site),
    ])
  : isHome
    ? graph([personSchema(site), websiteSchema(site)])
    : undefined;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={title ?? SITE.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_IN" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
      {article.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
      )}
      <meta property="article:author" content={new URL('/about/', site).href} />
      {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
