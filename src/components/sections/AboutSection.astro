---
/**
 * The About section of the single page: bio on ruled paper, the experience log,
 * results, education and certifications. Longer lists (what each role involved,
 * the full skills list, workshops) fold away in native <details>.
 */
import Button from '../Button.astro';
import Card from '../Card.astro';
import Tag from '../Tag.astro';

// Every fact in this section traces to docs/content-brief.md. Things the brief marks
// as TODO (the cleaned résumé, the third certification) stay off the site.

// TODO(Kushal): the résumé button stays hidden until a cleaned PDF (no phone, CGPA
// or SRN) is committed as public/resume.pdf. Then set this to true.
const hasResume = false;

interface Role {
  title: string;
  org: string;
  dates: string;
  points: string[];
}

const experience: Role[] = [
  {
    title: 'Summer Research Intern',
    org: 'Center for Cloud Computing and Big Data (CCBD), PES University',
    dates: 'Jun 2026 - Jul 2026',
    points: [
      'Worked on AdaptBank, a unified evaluation framework for the environmental robustness of AI agents.',
      'Evaluated agent robustness under Semantic Drift by running the ToolMisuseBench suite, one of four drift dimensions in the AdaptBank taxonomy.',
      'Computed Robustness Score, Recovery Performance Score and Context Adaptation Time, benchmarking 6 agents (including 2 frontier models) across all three metrics.',
      'Contributed cross-agent scoring to a standardized Environmental Robustness Score meant to power an agent leaderboard.',
      'Extended coverage to further drift suites (OpenApps, WebArena, tau-bench) spanning Interface, Workflow and Policy drift.',
    ],
  },
  {
    title: 'Event Manager',
    org: 'G Cube',
    dates: 'Feb 2026 - present',
    points: [
      'Designed the format, schedule and map-selection framework for a campus Valorant tournament (40 teams) and led its promotion.',
    ],
  },
  {
    title: 'Core Member, leadership team',
    org: 'Center for Information Security, Forensics and Cyber Resilience (ISFCR), PES University',
    dates: 'Jan 2026 - present',
    points: [
      'Partners with the Club Head to coordinate cross-functional teams, allocate tasks, and lead member recruitment and onboarding.',
    ],
  },
  {
    title: 'Head of Content and Media',
    org: 'ISFCR, PES University',
    dates: 'Sep 2025 - Jan 2026',
    points: [
      "Directed content strategy and production, including Instagram reels, for CRYOVAULT, the club's flagship CTF (60 teams from across India).",
      'Shot and edited live story coverage during the event.',
    ],
  },
  {
    title: 'Core Member',
    org: 'ISFCR, PES University',
    dates: 'Aug 2025 - Sep 2025',
    points: [],
  },
  {
    title: 'Computer Vision Trainee',
    org: 'PESU I/O, PES University',
    dates: 'Sep 2024 - Nov 2024',
    points: [],
  },
];

const achievements = [
  {
    title: 'Winner, AI Hackathon, IISc Bengaluru Workshop',
    meta: 'Techgyan Technologies · 2025 · team of 4',
    body: 'Built a machine-learning model to detect ambulance sirens, with applications in automated traffic management and emergency response.',
  },
  {
    title: 'CIE Spark 2025: Top 13 of 77 teams',
    meta: 'CIE, PES University · team of 4',
    body: 'HustleHub: validated the "Golden Hour" response gap after road accidents through 60+ customer interviews, and proposed a sensor-based IoT accident detection and emergency alert system.',
  },
  {
    title: 'Adobe hackathon: Top 9% of 3 lakh+ participants, coding round',
    meta: 'Team of 3',
    body: '',
  },
];

const skills = [
  { group: 'Languages', items: ['Python', 'TypeScript', 'C', 'C++', 'ARM Assembly'] },
  {
    group: 'AI and agent evaluation',
    items: [
      'Agent robustness evaluation',
      'LLM benchmarking',
      'Drift taxonomy analysis',
      'Tool-schema design for LLM APIs',
    ],
  },
  { group: 'Realtime and voice', items: ['OpenAI Realtime API (WebRTC)', 'Web Speech API'] },
  {
    group: 'Frameworks and libraries',
    items: ['FastAPI', 'SQLAlchemy', 'Alembic', 'React', 'Next.js', 'Tailwind CSS'],
  },
  {
    group: 'Tools and infrastructure',
    items: [
      'Git',
      'Docker',
      'PostgreSQL',
      'Neon serverless Postgres',
      'Vercel',
      'Vitest',
      'Playwright',
      'Claude Code',
      'Jira',
      'Notion',
      'ClickUp',
    ],
  },
  {
    group: 'Core CS',
    items: [
      'Data Structures & Algorithms',
      'Operating Systems',
      'Computer Networks',
      'Software Engineering',
    ],
  },
  {
    group: 'Beyond code',
    items: ['Project-management fundamentals', 'Computer vision basics', 'Customer discovery'],
  },
];

const education = [
  {
    title: 'B.Tech in Computer Science & Engineering',
    org: 'PES University',
    dates: '2024 - 2028',
    note: 'Relevant courses: DBMS, Machine Learning, Software Engineering, Data Analytics, Graph Theory.',
  },
  {
    title: 'DSA & Full-Stack Development (CCBP 4.0)',
    org: 'NxtWave x Woolf University',
    dates: '2025 - 2027',
    note: '',
  },
];

const certifications = [
  {
    title: 'Google Project Management Professional Certificate',
    meta: 'Google, via Coursera · Apr - Oct 2025',
    body: '140-hour program covering Agile and Scrum, stakeholder communication, risk management, documentation and real-world project simulations.',
  },
  { title: 'Introduction to Programming Using Python', meta: '2024', body: '' },
];

const activities = [
  'LLM Architecture & BERT Fine-Tuning Workshop, PES University (Encode.ai)',
  'Engenious ’25 Ideathon, Enactus PES University: a 12-hour team ideation challenge',
  'PeCon 2024, PES MUN Society: represented Lebanon',
  'Diplomat Wars 5.0, PES MUN Society: quiz, debate and courtroom rounds',
];
---

<section id="about" aria-labelledby="about-title">
  <div class="paper-ruled">
    <div class="container bio">
      <header class="section__head">
        <p class="mono eyebrow">About</p>
        <h2 id="about-title">A bit about me</h2>
      </header>
      <div class="bio__body">
        <p>
          I'm a Computer Science undergraduate at PES University in Bengaluru, building AI and data
          products. I did summer research at PES University's Center for Cloud Computing and Big
          Data, and I work on benchmarks for how LLM agents hold up when their environment changes.
        </p>
        <p>
          Outside coursework I build hackathon projects, lead club operations, and write a weekly AI
          explainer series. I'm aiming for forward-deployed engineering roles, with a side interest
          in finance and data analytics.
        </p>
        {hasResume && <Button href="/resume.pdf">Résumé (PDF)</Button>}
      </div>
    </div>
  </div>

  <div class="container section">
    <h3 class="section__title">Where I've worked</h3>
    <ol class="log paper-sheet" role="list">
      {
        experience.map((role) => (
          <li class="log__item">
            <p class="log__dates mono">{role.dates}</p>
            <div class="log__body">
              <h4>{role.title}</h4>
              <p class="log__org">{role.org}</p>
              {role.points.length === 1 && <p>{role.points[0]}</p>}
              {role.points.length > 1 && (
                <details class="more">
                  <summary class="mono">
                    What I did<span class="visually-hidden"> as {role.title}</span>
                  </summary>
                  <ul class="points">
                    {role.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="container section">
    <h3 class="section__title">Notable results</h3>
    <ul class="notes" role="list" data-reveal>
      {
        achievements.map((item) => (
          <li>
            <Card tape class="stack">
              <span class="mono meta">{item.meta}</span>
              <h4>{item.title}</h4>
              {item.body && <p>{item.body}</p>}
            </Card>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container section split">
    <div class="split__col">
      <h3 class="section__title">Education</h3>
      <ul class="plain" role="list">
        {
          education.map((item) => (
            <li>
              <p class="mono meta">{item.dates}</p>
              <h4>{item.title}</h4>
              <p class="log__org">{item.org}</p>
              {item.note && <p>{item.note}</p>}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="split__col">
      <h3 class="section__title">Certifications</h3>
      <ul class="plain" role="list">
        {
          certifications.map((item) => (
            <li>
              <p class="mono meta">{item.meta}</p>
              <h4>{item.title}</h4>
              {item.body && <p>{item.body}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container section extras">
    <details class="more">
      <summary class="mono">Full skills list</summary>
      <dl class="skills">
        {
          skills.map(({ group, items }) => (
            <div class="skills__row">
              <dt class="mono">{group}</dt>
              <dd>
                <ul class="tags" aria-label={group}>
                  {items.map((item) => (
                    <li>
                      <Tag>{item}</Tag>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="note">Spoken languages: English and Hindi (professional working proficiency).</p>
    </details>
    <details class="more">
      <summary class="mono">Workshops and activities</summary>
      <ul class="points">
        {activities.map((item) => <li>{item}</li>)}
      </ul>
    </details>
  </div>
</section>

<style>
/* ---- Bio, on ruled paper ---- */
  .bio {
    display: grid;
    align-items: start;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  @media (min-width: 60rem) {
    .bio {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    }
  }

  .bio__body {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  /* Text sits on the ruled lines. */
  .bio__body p {
    font-size: var(--text-lg);
    line-height: var(--paper-rule);
    color: var(--color-ink);
  }

  .section {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
    padding-block: var(--space-7) 0;
  }

  .section > * {
    min-width: 0;
  }

  .section__head {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }

.section__title {
    font-size: var(--text-xl);
  }

  /* ---- Experience: a logbook page, dates in the first column ---- */
  .log {
    display: grid;
    width: 100%;
    list-style: none;
  }

  .log__item {
    display: grid;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-rule);
  }

  .log__item:first-child {
    padding-top: 0;
  }

  .log__item:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  @media (min-width: 48rem) {
    .log__item {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  .log__dates {
    padding-top: 0.5em;
    color: var(--color-coral-ink);
  }

  .log__body {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }

  .log .points {
    padding-top: var(--space-2);
  }

  .log__body h4,
  .plain h4,
  .notes h4 {
    font-family: var(--font-display);
    font-weight: var(--font-weight-display);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-display);
    font-size: var(--text-lg);
  }

  .log__org {
    color: var(--color-ink);
    font-weight: var(--font-weight-strong);
  }

  .points {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    padding-left: 1.25em;
    color: var(--color-ink-muted);
  }

  .points li::marker {
    color: var(--color-ink);
  }

  /* ---- Results: notes taped to the page, each a little crooked ---- */
  .notes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-7) var(--space-6);
    width: 100%;
    padding: var(--space-3) 0 0;
    list-style: none;
  }

  .notes > li {
    display: grid;
  }

  .notes > li:nth-child(odd) {
    rotate: -0.8deg;
  }

  .notes > li:nth-child(even) {
    rotate: 0.7deg;
  }

  .notes :global(.stack) {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
    padding-top: var(--space-6);
  }

  .meta {
    color: var(--color-ink-soft);
  }

  /* ---- Folded extras: skills as a list with one group per row ---- */
  .extras {
    gap: var(--space-2);
  }

  .extras > details {
    width: 100%;
  }

  .skills {
    display: grid;
    width: 100%;
    margin-top: var(--space-3);
  }

  .skills__row {
    display: grid;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-4);
    border-bottom: var(--border-width-thin) dashed var(--color-ink-soft);
  }

  .skills__row:first-child {
    border-top: var(--border-width-thin) dashed var(--color-ink-soft);
  }

  @media (min-width: 48rem) {
    .skills__row {
      grid-template-columns: 14rem minmax(0, 1fr);
      align-items: start;
    }
  }

  .skills dt {
    padding-top: 0.35em;
    color: var(--color-ink);
  }

  .skills dd {
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .note {
    margin-top: var(--space-4);
    color: var(--color-ink-muted);
  }

  .extras .points {
    margin-top: var(--space-3);
  }

  /* ---- Education + certifications ---- */
  .split {
    gap: var(--space-8);
  }

  @media (min-width: 60rem) {
    .split {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .split__col {
    display: grid;
    gap: var(--space-5);
  }

  .plain {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .plain > li {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-margin);
  }
</style>
