---
/**
 * Small bordered mono label: section eyebrows, status labels, stack tags.
 * Linked tags (`href`) get press physics; plain tags stay static.
 */
type Tone = 'cream' | 'ink' | 'coral' | 'yellow' | 'green' | 'blue' | 'purple';

interface Props {
  tone?: Tone;
  href?: string;
  class?: string;
}

const { tone = 'cream', href, class: className } = Astro.props;
const classes = ['tag', `tag--${tone}`, 'mono', { 'tag--link press': href }, className];
---

{
  href ? (
    <a href={href} class:list={classes}>
      <slot />
    </a>
  ) : (
    <span class:list={classes}>
      <slot />
    </span>
  )
}

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-2);
    border: var(--border-thin);
    border-radius: var(--radius-card);
    line-height: 1.3;
    background: var(--_bg);
    color: var(--_fg);
  }

  .tag--link {
    /* Scaled-down press physics for a small target. */
    --shadow-rest: var(--shadow-sm);
    --shadow-hover: 4px 4px 0 0 var(--color-ink);
    --press: 3px;
    text-decoration: none;
  }

  .tag--cream {
    --_bg: var(--color-bg);
    --_fg: var(--color-ink);
  }

  .tag--ink {
    --_bg: var(--color-ink);
    --_fg: var(--color-white);
  }

  .tag--coral {
    --_bg: var(--color-coral);
    --_fg: var(--color-ink);
  }

  .tag--yellow {
    --_bg: var(--color-yellow);
    --_fg: var(--color-ink);
  }

  .tag--green {
    --_bg: var(--color-green);
    --_fg: var(--color-ink);
  }

  .tag--blue {
    --_bg: var(--color-blue);
    --_fg: var(--color-white);
  }

  .tag--purple {
    --_bg: var(--color-purple);
    --_fg: var(--color-white);
  }
</style>
