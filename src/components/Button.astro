---
import type { HTMLAttributes } from 'astro/types';

/**
 * Stamp-style button with press physics. Renders an <a> when `href` is set,
 * otherwise a <button>. Variants: primary (ink on paper, coral shadow), secondary
 * (outlined), accent (white, for the blueprint band), inverse (outlined white,
 * for the blueprint band).
 */
type Variant = 'primary' | 'secondary' | 'accent' | 'inverse';

type Props = {
  variant?: Variant;
  href?: string;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'href'>;

const { variant = 'primary', href, class: className, type, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, 'press', 'mono', className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type ?? 'button'} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    /* Rubber-stamp rectangle with a solid pen-coloured offset shadow. */
    --shadow-rest: var(--shadow-offset-rest) var(--shadow-offset-rest) 0 0 var(--_sh);
    --shadow-hover: var(--shadow-offset-hover) var(--shadow-offset-hover) 0 0 var(--_sh);
    --shadow-pressed: 0 0 0 0 var(--_sh);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.875rem; /* 46px touch target */
    padding: var(--space-3) var(--space-5);
    border: var(--border-width) solid var(--_bd, var(--color-ink));
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    background: var(--_bg);
    color: var(--_fg);
  }

  .btn--primary {
    --_bg: var(--color-primary);
    --_fg: var(--color-on-primary);
    --_sh: var(--color-coral);
  }

  .btn--secondary {
    --_bg: var(--color-bg);
    --_fg: var(--color-ink);
    --_sh: var(--color-ink);
  }

  .btn--accent {
    --_bg: var(--color-white);
    --_fg: var(--color-blueprint);
    --_bd: var(--color-white);
    --_sh: var(--color-coral);
  }

  .btn--inverse {
    --_bg: transparent;
    --_fg: var(--color-white);
    --_bd: var(--color-white);
    --_sh: rgb(255 255 255 / 0.35);
  }
</style>
