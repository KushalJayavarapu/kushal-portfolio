---
import { NAV, SITE } from '../config/site';

// Motion catalogue #9: link underlines slide in from the left; the current
// section gets a solid highlight block.
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="wordmark"
      >{SITE.wordmark}<span class="visually-hidden">, {SITE.name}, home</span></a
    >
    <nav aria-label="Main">
      <ul class="nav">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav__link mono"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-4);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1;
    text-decoration: none;
    letter-spacing: var(--tracking-display);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    padding: 0;
    list-style: none;
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    text-decoration: none;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    bottom: 0.6rem;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-hover) var(--ease-snap);
  }

  .nav__link:hover::after,
  .nav__link:focus-visible::after {
    transform: scaleX(1);
  }

  .nav__link[aria-current='page'] {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .nav__link[aria-current='page']::after {
    display: none;
  }
</style>
