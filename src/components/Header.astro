---
import { NAV, SITE } from '../config/site';
import Scribble from './Scribble.astro';

// The header sticks to the top and its links jump to sections of the home page.
// Motion catalogue #9: a coral pen underline slides in from the left on hover
// and stays drawn under the current section. On the home page a small inline
// script moves it as you scroll; on writing pages it sits under "Writing".
const path = Astro.url.pathname;
const isCurrent = (section: string) => path.startsWith(`/${section}/`);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="wordmark"
      ><span class="wordmark__full">{SITE.name}</span><span class="wordmark__short" aria-hidden="true"
        >{SITE.wordmark}</span
      ><span class="visually-hidden">, home</span><Scribble
        shape="underline-thin"
        class="wordmark__mark"
      /></a
    >
    <nav aria-label="Main">
      <ul class="nav">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav__link mono"
                data-section={item.section}
                aria-current={isCurrent(item.section) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<!-- Marks the section in view as current. Enhancement only: without it the links still jump. -->
<script is:inline>
  // The header is parsed before the sections exist, so wait for the document.
  document.addEventListener('DOMContentLoaded', () => {
    const links = [...document.querySelectorAll('.nav__link[data-section]')];
    const sections = links.map((link) => document.getElementById(link.dataset.section));
    if (sections.some((el) => !el) || !('IntersectionObserver' in window)) return;
    const top = document.getElementById('top');
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) => {
            if (link.dataset.section === entry.target.id) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          });
        });
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    [top, ...sections].forEach((el) => el && spy.observe(el));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-grid);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-2);
  }

  /* Narrow screens get the initials so the header stays one row tall. */
  .wordmark__full {
    display: none;
  }

  @media (min-width: 44rem) {
    .site-header__inner {
      padding-block: var(--space-3);
    }

    .wordmark__full {
      display: inline;
    }

    .wordmark__short {
      display: none;
    }
  }

  .wordmark {
    position: relative;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1.2;
    text-decoration: none;
    letter-spacing: var(--tracking-display);
  }

  .wordmark :global(.wordmark__mark) {
    position: absolute;
    left: 0;
    bottom: -7px;
    width: 100%;
    height: 10px;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-1);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 44rem) {
    .nav {
      gap: var(--space-1) var(--space-2);
    }
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-1);
    text-decoration: none;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: var(--space-1);
    right: var(--space-1);
    bottom: 0.6rem;
    height: 2px;
    background: var(--color-coral);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-hover) var(--ease-snap);
  }

  .nav__link:hover::after,
  .nav__link:focus-visible::after {
    transform: scaleX(1);
  }

  /* Current section: the underline stays drawn. */
  .nav__link[aria-current]::after {
    transform: scaleX(1);
  }
</style>
