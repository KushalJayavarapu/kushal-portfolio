---
/**
 * Project summary card for the Projects index (and the home page's featured row).
 * The whole card links to the case study, so it carries no nested links.
 */
import { Image } from 'astro:assets';
import Card from './Card.astro';
import Tag from './Tag.astro';
import { projectHref, projectTitleTransition, type Project } from '../lib/projects';

interface Props {
  project: Project;
  tone?: 'surface' | 'cream' | 'yellow';
  headingLevel?: 'h2' | 'h3';
  /** Entry number shown as a handwritten note in the corner, e.g. 1 -> "no. 01". */
  number?: number;
  /** How many stack tags to show before collapsing the rest into "+N". */
  maxStack?: number;
}

const { project, tone = 'surface', headingLevel: Heading = 'h3', number, maxStack = 4 } = Astro.props;
const { title, summary, context, stack, result, status, cover, coverAlt } = project.data;
const shown = stack.slice(0, maxStack);
const hidden = stack.length - shown.length;
---

<Card href={projectHref(project)} tone={tone} class="project-card">
  {
    number !== undefined && (
      <span class="project-card__no hand" aria-hidden="true">
        no. {String(number).padStart(2, '0')}
      </span>
    )
  }
  {
    cover && (
      <Image
        class="project-card__cover"
        src={cover}
        alt={coverAlt ?? ''}
        widths={[400, 800]}
        sizes="(min-width: 60rem) 22rem, 90vw"
      />
    )
  }
  {context && <p class="project-card__context mono">{context}</p>}
  <Heading class="project-card__title" transition:name={projectTitleTransition(project)}>
    {title}
  </Heading>
  <p class="project-card__summary">{summary}</p>
  {result && <Tag tone="green">{result}</Tag>}
  {status && <span class="project-card__stamp mono">{status}</span>}
  {
    shown.length > 0 && (
      <ul class="project-card__stack" aria-label={`${title} ${project.data.stackLabel.toLowerCase()}`}>
        {shown.map((item) => (
          <li>
            <Tag>{item}</Tag>
          </li>
        ))}
        {hidden > 0 && (
          <li>
            <Tag tone="ink">
              +{hidden}
              <span class="visually-hidden"> more</span>
            </Tag>
          </li>
        )}
      </ul>
    )
  }
  <span class="project-card__cta mono" aria-hidden="true">Read case study <span class="arrow">&rarr;</span></span>
</Card>

<style>
  /* The root element is rendered (and scoped) by Card, so it needs :global; the
     element selector outranks Card's own `display: block`. */
  :global(a.card.project-card) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    height: 100%;
    --rest-tilt: -1.1deg;
  }

  /* Motion #7, sticker tilt: neighbouring notes are taped on at different angles
     and straighten when picked up. */
  :global(li:nth-child(3n + 2) > a.card.project-card) {
    --rest-tilt: 0.9deg;
  }

  :global(li:nth-child(3n) > a.card.project-card) {
    --rest-tilt: -0.5deg;
  }

  .project-card__no {
    position: absolute;
    top: var(--space-3);
    right: var(--space-4);
    font-size: 1.35rem;
    transform: rotate(4deg);
  }

  .project-card__cover {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin-bottom: var(--space-1);
  }

  .project-card__context {
    /* Leaves the corner clear for the handwritten entry number. */
    padding-right: 4.5rem;
    color: var(--color-ink-soft);
  }

  .project-card__title {
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .project-card__summary {
    color: var(--color-ink-muted);
    font-size: 0.96rem;
  }

  /* Rubber stamp for a status such as "paper awaiting publication approval". */
  .project-card__stamp {
    padding: var(--space-1) var(--space-2);
    border: 2.5px solid var(--color-coral-ink);
    color: var(--color-coral-ink);
    line-height: 1.3;
    transform: rotate(-2deg);
  }

  .project-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .project-card__cta {
    margin-top: auto;
    padding-top: var(--space-2);
  }
</style>
