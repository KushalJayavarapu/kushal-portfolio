---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Highlight from '../components/Highlight.astro';
import Scribble from '../components/Scribble.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import IndexCard from '../components/IndexCard.astro';
import TypingLine from '../components/TypingLine.astro';
import StackMarquee from '../components/StackMarquee.astro';
import PostCard from '../components/writing/PostCard.astro';
import { getProjects } from '../lib/projects';
import { getPosts } from '../lib/blog';
import { SITE, SOCIAL } from '../config/site';
import { WRITING } from '../config/writing';

// Every line of copy here traces to docs/content-brief.md.

// The whole site is this one page: hero, projects, about, writing, contact.
// The header's links jump to the section ids below. Only blog posts (and the
// post archive at /writing/) are separate pages.
const projects = await getProjects();
const posts = (await getPosts()).slice(0, 3);

// Motion catalogue #4: the approved typing-line phrases (docs/content-brief.md).
// The first one is the static fallback for no-JS and reduced motion.
const typingPhrases = [
  'builds AI systems that hold up under change.',
  'turns hackathon ideas into working prototypes.',
  'writes weekly about AI in plain words.',
  'studies how LLM agents adapt.',
];

// Motion catalogue #6: the stack marquee lists tools evidenced in the brief's skills section.
const stack = [
  'Python',
  'TypeScript',
  'FastAPI',
  'React',
  'Next.js',
  'PostgreSQL',
  'SQLAlchemy',
  'Docker',
  'Git',
  'Claude Code',
  'OpenAI Realtime API',
  'Tailwind CSS',
  'Playwright',
  'Vitest',
  'Vercel',
  'C++',
];

// The hero portrait is optional: drop `kushal.jpg` (or .jpeg/.png/.webp) into
// src/assets/photos/ and it appears as a taped print. No placeholder otherwise.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/kushal.{jpg,jpeg,png,webp}',
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default;

const facts = [
  { label: 'Studying', value: 'B.Tech CSE, PES University, 2024 to 2028' },
  { label: 'Research', value: 'AdaptBank, agent robustness under drift' },
  { label: 'Writing', value: 'The Footnote, weekly on LinkedIn' },
  { label: 'Looking for', value: 'Forward-deployed engineering roles' },
];
---

<BaseLayout>
  <section id="top" class="container hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="mono hero__eyebrow rise" style="--i: 0">CS student · PES University, Bengaluru</p>
      <h1 id="hero-title" class="rise" style="--i: 1">
        I build AI systems that <Highlight>hold up</Highlight> under change.
      </h1>
      <TypingLine
        class="hero__typing rise"
        label="currently"
        subject="Kushal"
        phrases={typingPhrases}
      />
      <p class="hero__lede rise" style="--i: 3">{SITE.description}</p>
      <div class="actions rise" style="--i: 4">
        <Button href="#projects">See my projects <span class="arrow">&darr;</span></Button>
        <Button href="#contact" variant="secondary">Get in touch</Button>
      </div>
    </div>

    <div class="hero__side rise" style="--i: 5">
      {
        portrait && (
          <figure class="photo">
            <div class="photo__frame tape">
              <Image
                src={portrait}
                alt={`Portrait of ${SITE.name}`}
                widths={[360, 720]}
                sizes="(min-width: 60rem) 22rem, 80vw"
                loading="eager"
              />
              <figcaption class="hand">Bengaluru, 2026</figcaption>
            </div>
            <span class="photo__note hand" aria-hidden="true">
              that's me!
              <Scribble shape="arrow-right" tone="blue" />
            </span>
          </figure>
        )
      }
      <IndexCard title="At a glance" facts={facts} />
    </div>
  </section>

  <StackMarquee items={stack} label="Tools I work with" heading="On my desk" />

  {
    projects.length > 0 && (
      <section id="projects" class="container section" aria-labelledby="projects-title">
        <header class="section__head">
          <p class="mono eyebrow">Projects · {projects.length} entries</p>
          <h2 id="projects-title">Things I've built</h2>
          <span class="start-here hand" aria-hidden="true">
            start here
            <Scribble shape="arrow-down" tone="blue" />
          </span>
        </header>
        <nav class="jump" aria-label="Jump to a project">
          <ol>
            {projects.map((project, i) => (
              <li>
                <a href={`#${project.id}`}>
                  <span class="mono" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  {project.data.title}
                </a>
              </li>
            ))}
          </ol>
        </nav>
        <ol class="entries" role="list">
          {projects.map((project, i) => (
            <li>
              <ProjectEntry project={project} number={i + 1} />
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <AboutSection />

  <section id="writing" class="container section" aria-labelledby="writing-title">
    <header class="section__head">
      <p class="mono eyebrow">Writing</p>
      <h2 id="writing-title">I explain AI in plain words</h2>
    </header>
    <ul class="grid" role="list" data-reveal>
      {
        posts.map((post) => <PostCard post={post} />)
      }
      <li>
        <Card href={SOCIAL.linkedin} tone="yellow" class="post">
          <span class="mono post__when">Every Tuesday on LinkedIn</span>
          <h3>The Footnote</h3>
          <p>A weekly series that explains AI in plain words, with minimal jargon.</p>
          <span class="mono post__cta" aria-hidden="true">
            Follow on LinkedIn <span class="arrow">&rarr;</span>
          </span>
        </Card>
      </li>
    </ul>
    {
      posts.length > 0 && (
        <div class="actions">
          <Button href="/writing/" variant="secondary">
            All posts <span class="arrow">&rarr;</span>
          </Button>
          <Button href={WRITING.feedPath} variant="secondary">
            Blog feed
          </Button>
        </div>
      )
    }
  </section>

  <ContactSection />
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    padding-block: var(--space-6) var(--space-8);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    }
  }

  .hero__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .hero h1 {
    font-size: clamp(2.5rem, 1.5rem + 3.6vw, 4.4rem);
  }

  .hero__eyebrow,
  .eyebrow {
    color: var(--color-ink-soft);
    max-width: none;
  }

  .hero :global(.hero__typing) {
    --i: 2;
  }

  .hero__lede {
    font-size: var(--text-lg);
  }

  .hero__side {
    display: grid;
    gap: var(--space-6);
    justify-items: center;
  }

  /* The portrait: a print with a white border, taped on at an angle. */
  .photo {
    position: relative;
    width: min(100%, 22rem);
  }

  .photo__frame {
    position: relative;
    padding: 12px 12px var(--space-2);
    background: var(--color-white);
    box-shadow: var(--shadow-rest);
    transform: rotate(2.2deg);
  }

  .photo__frame.tape::before {
    width: 120px;
    top: -14px;
  }

  .photo__frame :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .photo figcaption {
    padding-top: var(--space-2);
    text-align: center;
    font-size: 1.4rem;
    color: var(--color-ink-muted);
  }

  .photo__note {
    display: none;
    position: absolute;
    left: -7.5rem;
    top: 44%;
    transform: rotate(-7deg);
  }

  .photo__note :global(svg) {
    display: block;
    width: 92px;
    height: 44px;
    margin: 2px 0 0 34px;
  }

  /* Only where there is clear margin beside the print, so it never crosses the headline. */
  @media (min-width: 86rem) {
    .photo__note {
      display: block;
    }
  }

  /*
   * Motion catalogue #3, hero entrance. Lines rise into place with a stagger.
   * Deliberately transform only, no opacity fade: the headline is the LCP element
   * and must paint at full opacity on the first frame. Reduced motion zeroes the
   * duration tokens, and the media query skips the animation entirely.
   */
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.rise) {
      animation: hero-rise var(--dur-hero) var(--ease-out) both;
      animation-delay: calc(var(--i, 0) * var(--stagger));
    }
  }

  @keyframes hero-rise {
    from {
      transform: translateY(16px);
    }
  }

  /* ---- Shared section layout ---- */
  .section {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  .section > * {
    min-width: 0;
  }

  .section__head {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }

  .start-here {
    display: none;
    position: absolute;
    left: calc(100% + var(--space-7));
    top: 0;
    white-space: nowrap;
    transform: rotate(4deg);
  }

  .start-here :global(svg) {
    display: block;
    width: 70px;
    height: 46px;
    margin: 4px 0 0 18px;
  }

  @media (min-width: 60rem) {
    .start-here {
      display: block;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-6);
    width: 100%;
    padding: 0;
    list-style: none;
  }

  .grid > li {
    display: grid;
  }

  .grid :global(.post) {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
  }

  .post__when {
    color: var(--color-coral-ink);
  }

/* ---- Projects: a jump list, then one sheet per project ---- */
  .jump ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    padding: 0;
    list-style: none;
  }

  .jump a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding-block: var(--space-2);
    font-weight: var(--font-weight-strong);
    text-decoration-color: var(--color-coral);
  }

  .jump .mono {
    color: var(--color-coral-ink);
  }

  .entries {
    display: grid;
    gap: var(--space-8);
    width: 100%;
    padding: var(--space-3) 0 0;
    list-style: none;
  }

  .entries > li {
    min-width: 0;
  }
</style>
