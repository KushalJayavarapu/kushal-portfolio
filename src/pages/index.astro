---
import BaseLayout from '../layouts/BaseLayout.astro';
import Highlight from '../components/Highlight.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Tag from '../components/Tag.astro';
import EmailReveal from '../components/EmailReveal.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/writing/PostCard.astro';
import { getProjects } from '../lib/projects';
import { getPosts } from '../lib/blog';
import { SITE, SOCIAL } from '../config/site';

// Every line of copy here traces to docs/content-brief.md.

// Featured projects and latest writing come from the collections T3 and T4 fill.
// Each section stays hidden until it has at least one published entry.
const featured = (await getProjects()).filter(({ data }) => data.featured).slice(0, 4);
const posts = (await getPosts()).slice(0, 3);

// Motion catalogue #4 (typing line) is added in the motion pass (T5b). Until then,
// and under reduced motion afterwards, the first approved phrase shows as static text.
const typingPhrase = 'builds AI systems that hold up under change.';

const facts = [
  { label: 'Studying', value: 'B.Tech in Computer Science & Engineering, PES University (2024 - 2028)' },
  { label: 'Research', value: 'AdaptBank, an evaluation framework for how LLM agents behave when their environment changes' },
  { label: 'Writing', value: 'The Footnote, a weekly AI explainer series on LinkedIn' },
  { label: 'Looking for', value: 'Forward-deployed engineering roles' },
];
---

<BaseLayout>
  <section class="container hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <div class="rise" style="--i: 0"><Tag>Bengaluru, India</Tag></div>
      <h1 id="hero-title" class="rise" style="--i: 1">
        Kushal <Highlight>Jayavarapu</Highlight>
      </h1>
      <p class="hero__typing rise" style="--i: 2">Kushal {typingPhrase}</p>
      <p class="hero__lede rise" style="--i: 3">{SITE.description}</p>
      <div class="actions rise" style="--i: 4">
        <Button href="/projects/">See my projects</Button>
        <Button href="/contact/" variant="secondary">Get in touch</Button>
      </div>
    </div>

    <div class="rise" style="--i: 5">
    <Card as="div" class="hero__facts">
      <Tag tone="ink">At a glance</Tag>
      <dl>
        {
          facts.map(({ label, value }) => (
            <div>
              <dt class="mono">{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </Card>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="container section" aria-labelledby="projects-title">
        <header class="section__head">
          <Tag tone="yellow">Selected work</Tag>
          <h2 id="projects-title">
            Featured <Highlight tone="ink">projects</Highlight>
          </h2>
        </header>
        <ul class="grid" role="list">
          {featured.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
        <Button href="/projects/" variant="secondary">All projects</Button>
      </section>
    )
  }

  <section class="container section about" aria-labelledby="about-title">
    <header class="section__head">
      <Tag tone="green">About</Tag>
      <h2 id="about-title">A bit <Highlight tone="ink">about me</Highlight></h2>
    </header>
    <div class="about__body">
      <p>
        I'm a Computer Science undergraduate at PES University in Bengaluru, building AI and data
        products. I did summer research at PES University's Center for Cloud Computing and Big Data,
        and I work on benchmarks for how LLM agents hold up when their environment changes.
      </p>
      <Button href="/about/" variant="secondary">More about me</Button>
    </div>
  </section>

  <section class="container section" aria-labelledby="writing-title">
    <header class="section__head">
      <Tag tone="blue">Writing</Tag>
      <h2 id="writing-title">Latest <Highlight tone="ink">writing</Highlight></h2>
    </header>
    <ul class="grid" role="list">
      {
        posts.map((post) => <PostCard post={post} />)
      }
      <li>
        <Card href={SOCIAL.linkedin} tone="yellow" class="post">
          <span class="mono">Every Tuesday on LinkedIn</span>
          <h3>The Footnote</h3>
          <p>A weekly series that explains AI in plain words, with minimal jargon.</p>
        </Card>
      </li>
    </ul>
  </section>

  <section id="contact" class="container section" aria-labelledby="contact-title">
    <Card as="div" tone="blue" class="cta">
      <h2 id="contact-title">Get in touch</h2>
      <p>
        I'm aiming for forward-deployed engineering roles, with a side interest in finance and data
        analytics.
      </p>
      <div class="actions">
        <EmailReveal variant="accent" />
        <Button href={SOCIAL.linkedin} variant="inverse" rel="me">LinkedIn</Button>
        <Button href={SOCIAL.github} variant="inverse" rel="me">GitHub</Button>
      </div>
    </Card>
  </section>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    padding-block: var(--space-8) var(--space-7);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }

  .hero__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .hero__typing {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-strong);
    color: var(--color-ink);
  }

  .hero__lede {
    font-size: var(--text-lg);
  }

  .hero :global(.hero__facts) {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .hero dl {
    display: grid;
    gap: var(--space-4);
  }

  .hero dt {
    color: var(--color-ink-soft);
  }

  .hero dd {
    margin: 0;
    font-weight: var(--font-weight-strong);
    line-height: var(--leading-snug);
  }

  /*
   * Motion catalogue #3, hero entrance. Lines rise into place with a stagger.
   * Deliberately transform only, no opacity fade: the headline is the LCP element
   * and must paint at full opacity on the first frame. Reduced motion zeroes the
   * duration tokens, and the media query skips the animation entirely.
   */
  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: hero-rise var(--dur-hero) var(--ease-out) both;
      animation-delay: calc(var(--i, 0) * var(--stagger));
    }
  }

  @keyframes hero-rise {
    from {
      transform: translateY(16px);
    }
  }

  /* ---- Shared section layout ---- */
  .section {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
    padding-block: var(--space-8) 0;
  }

  .section__head {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-6);
    width: 100%;
    padding: 0;
    list-style: none;
  }

  .grid > li {
    display: grid;
  }

  .grid :global(.post) {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
  }

  /* ---- About teaser ---- */
  .about__body {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .about__body p {
    font-size: var(--text-lg);
  }

  /* ---- Contact banner ---- */
  .section :global(.cta) {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    width: 100%;
    padding: var(--space-7) var(--space-6);
  }

  .cta h2 {
    color: var(--color-white);
  }
</style>
