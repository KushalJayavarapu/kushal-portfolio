---
import BaseLayout from '../layouts/BaseLayout.astro';
import Highlight from '../components/Highlight.astro';
import Button from '../components/Button.astro';
import Tag from '../components/Tag.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <section class="container not-found">
    <Tag tone="coral">Error 404</Tag>
    <h1>Nothing <Highlight>here</Highlight>.</h1>
    <p>The page you were looking for has moved or never existed.</p>
    <Button href="/">Back to home</Button>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    padding-block: var(--space-9);
  }
</style>
