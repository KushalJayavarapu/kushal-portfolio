---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Highlight from '../../../components/Highlight.astro';
import Tag from '../../../components/Tag.astro';
import PostCard from '../../../components/writing/PostCard.astro';
import TagFilter from '../../../components/writing/TagFilter.astro';
import { WRITING } from '../../../config/writing';
import { collectTags, getPosts, tagSlug } from '../../../lib/blog';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const tags = collectTags(posts);
  return tags.map(({ slug, tag }) => ({
    params: { tag: slug },
    props: {
      tag,
      tags,
      posts: posts.filter((post) => post.data.tags.some((t) => tagSlug(t) === slug)),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, tags, posts } = Astro.props;
const { tag: slug } = Astro.params;
---

<BaseLayout
  title={`${tag} · ${WRITING.title}`}
  description={`Posts tagged “${tag}” by Kushal Jayavarapu.`}
>
  <link slot="head" rel="alternate" type="application/rss+xml" href={WRITING.feedPath} />

  <section class="container intro">
    <a class="back mono" href="/writing/">← All writing</a>
    <Tag>Tag</Tag>
    <h1><Highlight>{tag}</Highlight></h1>
    <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  </section>

  <section class="container posts" aria-label={`Posts tagged ${tag}`}>
    <TagFilter tags={tags} current={slug} />
    <ul class="posts__list">
      {posts.map((post) => <PostCard post={post} headingLevel="h2" />)}
    </ul>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-block: var(--space-7) var(--space-6);
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .posts {
    display: grid;
    gap: var(--space-5);
  }

  .posts__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-6);
    padding: 0;
  }
</style>
