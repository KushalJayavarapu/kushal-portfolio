---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Highlight from '../../components/Highlight.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import Tag from '../../components/Tag.astro';
import PostCard from '../../components/writing/PostCard.astro';
import TagFilter from '../../components/writing/TagFilter.astro';
import { FOOTNOTE, WRITING } from '../../config/writing';
import { collectTags, formatDate, getPosts } from '../../lib/blog';

const posts = await getPosts();
const tags = collectTags(posts);
---

<BaseLayout title={WRITING.title} description={WRITING.description}>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title={`${WRITING.title} · Kushal Jayavarapu`}
    href={WRITING.feedPath}
  />

  <section class="container intro">
    <Tag>Writing</Tag>
    <h1>About AI, in plain <Highlight>words</Highlight></h1>
    <p class="intro__lede">
      Longer notes live here. The weekly series lives on LinkedIn.
    </p>
  </section>

  <section class="container" aria-labelledby="footnote-title">
    <Card tone="yellow" as="section" class="footnote">
      <Tag tone="ink">Weekly · Tuesdays</Tag>
      <h2 id="footnote-title">{FOOTNOTE.name}</h2>
      <p>{FOOTNOTE.blurb}</p>
      {
        FOOTNOTE.issues.length > 0 && (
          <div class="footnote__issues">
            <h3 class="mono">Latest issues</h3>
            <ol>
              {FOOTNOTE.issues.slice(0, 3).map((issue) => (
                <li>
                  <a href={issue.href} rel="noopener">
                    {issue.title}
                  </a>
                  <time class="mono" datetime={issue.date}>
                    {formatDate(new Date(issue.date))}
                  </time>
                </li>
              ))}
            </ol>
          </div>
        )
      }
      <Button href={FOOTNOTE.followHref} variant="secondary" rel="noopener">
        Follow on LinkedIn <span class="visually-hidden">(opens LinkedIn)</span>
      </Button>
    </Card>
  </section>

  <section class="container posts" aria-labelledby="posts-title">
    <div class="posts__head">
      <h2 id="posts-title">Posts</h2>
      <Button href={WRITING.feedPath} variant="secondary">RSS feed</Button>
    </div>
    <TagFilter tags={tags} />
    {
      posts.length > 0 ? (
        <ul class="posts__list">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </ul>
      ) : (
        <Card tone="cream" as="div" class="posts__empty">
          <p>No posts yet. Subscribe to the RSS feed to get the first one.</p>
        </Card>
      )
    }
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    padding-block: var(--space-8) var(--space-7);
  }

  .intro__lede {
    font-size: var(--text-lg);
  }

  .container :global(.footnote) {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding: var(--space-6);
  }

  .footnote__issues {
    width: 100%;
  }

  .footnote__issues ol {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .footnote__issues li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-2);
    border-bottom: var(--border-thin);
  }

  .posts {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-8);
  }

  .posts__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .posts__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-6);
    padding: 0;
  }
</style>
