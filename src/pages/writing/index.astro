---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Highlight from '../../components/Highlight.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import PostCard from '../../components/writing/PostCard.astro';
import TagFilter from '../../components/writing/TagFilter.astro';
import { FOOTNOTE, WRITING } from '../../config/writing';
import { collectTags, formatDate, getPosts } from '../../lib/blog';

const posts = await getPosts();
const tags = collectTags(posts);
---

<BaseLayout title={WRITING.title} description={WRITING.description}>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title={`${WRITING.title} · Kushal Jayavarapu`}
    href={WRITING.feedPath}
  />

  <section class="container intro">
    <p class="mono eyebrow">Writing</p>
    <h1>About AI, in plain <Highlight>words</Highlight>.</h1>
    <p class="intro__lede">
      Longer notes live here. The weekly series lives on LinkedIn.
    </p>
  </section>

  <div class="container layout">
    <aside class="footnote-slot" aria-labelledby="footnote-title">
      <Card tone="yellow" tape as="div" class="footnote">
      <p class="mono footnote__when">Weekly · Tuesdays</p>
      <h2 id="footnote-title">{FOOTNOTE.name}</h2>
      <p>{FOOTNOTE.blurb}</p>
      {
        FOOTNOTE.issues.length > 0 && (
          <div class="footnote__issues">
            <h3 class="mono">Latest issues</h3>
            <ol>
              {FOOTNOTE.issues.slice(0, 3).map((issue) => (
                <li>
                  <a href={issue.href} rel="noopener">
                    {issue.title}
                  </a>
                  <time class="mono" datetime={issue.date}>
                    {formatDate(new Date(issue.date))}
                  </time>
                </li>
              ))}
            </ol>
          </div>
        )
      }
      <Button href={FOOTNOTE.followHref} variant="secondary" rel="noopener">
        Follow on LinkedIn <span class="arrow">&rarr;</span>
        <span class="visually-hidden">(opens LinkedIn)</span>
      </Button>
      </Card>
    </aside>

    <section class="posts" aria-labelledby="posts-title">
      <div class="posts__head">
        <h2 id="posts-title">Posts</h2>
        <Button href={WRITING.feedPath} variant="secondary">Blog feed</Button>
      </div>
      <TagFilter tags={tags} />
      {
        posts.length > 0 ? (
          <ul class="posts__list" data-reveal>
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </ul>
        ) : (
          <div class="posts__empty paper-sheet">
            <p>No posts yet. Subscribe to the blog feed to get the first one.</p>
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .intro {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    padding-block: var(--space-8) var(--space-7);
  }

  .intro__lede {
    font-size: var(--text-lg);
  }

  /* Posts are the main column; The Footnote is a sticky note beside them. */
  .layout {
    display: grid;
    align-items: start;
    gap: var(--space-8);
  }

  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 21rem;
      gap: var(--space-7);
    }

    .footnote-slot {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: var(--space-6);
    }
  }

  .layout :global(.footnote) {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    max-width: 30rem;
    padding: var(--space-7) var(--space-5) var(--space-5);
    rotate: 1.2deg;
  }

  .footnote__when {
    color: var(--color-coral-ink);
  }

  .layout :global(.footnote) h2 {
    font-size: var(--text-xl);
  }

  .footnote__issues {
    width: 100%;
  }

  .footnote__issues ol {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .footnote__issues li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-2);
    border-bottom: var(--border-width-thin) dashed var(--color-ink-soft);
  }

  .posts {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .posts__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .posts__head h2 {
    font-size: var(--text-xl);
  }

  .posts__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-7) var(--space-6);
    padding: var(--space-3) 0 0;
  }
</style>
