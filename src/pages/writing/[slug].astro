---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import { WRITING } from '../../config/writing';
import { formatDate, getPosts, readingMinutes, tagHref, type Post } from '../../lib/blog';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props as { post: Post };
const { title, description, pubDate, updatedDate, tags, draft } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={description}>
  <link slot="head" rel="alternate" type="application/rss+xml" href={WRITING.feedPath} />
  {draft && <meta slot="head" name="robots" content="noindex" />}

  <article class="container post">
    <header class="post__header">
      <a class="back mono" href="/writing/">← All writing</a>
      {
        draft && (
          <p class="post__draft" role="note">
            <Tag tone="coral">Draft</Tag>
            <span>Unpublished placeholder. Only visible in local development.</span>
          </p>
        )
      }
      <h1 class="post__title">{title}</h1>
      <p class="post__lede">{description}</p>
      <p class="post__meta mono">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(post.body)} min read</span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </span>
            </>
          )
        }
      </p>
      {
        tags.length > 0 && (
          <ul class="post__tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>
                <Tag href={tagHref(tag)}>{tag}</Tag>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post__footer">
      <a class="back mono" href="/writing/">← All writing</a>
      <a class="back mono" href={WRITING.feedPath}>RSS feed</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    --post-measure: 42rem;
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-7) 0;
  }

  .post > * {
    width: 100%;
    max-width: var(--post-measure);
  }

  .post__header {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: var(--border);
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .post__draft {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: var(--border-thin);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .post__title {
    font-size: var(--text-2xl);
  }

  .post__lede {
    font-size: var(--text-lg);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-ink-soft);
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .post__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: var(--border);
  }

  /* ---- Long-form body ---- */
  .prose {
    display: grid;
    gap: var(--space-5);
  }

  .prose :global(h2) {
    margin-top: var(--space-5);
    font-size: var(--text-xl);
  }

  .prose :global(h3) {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
  }

  .prose :global(:is(ul, ol)) {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
    color: var(--color-ink-muted);
  }

  .prose :global(li::marker) {
    color: var(--color-ink);
  }

  .prose :global(blockquote) {
    padding: var(--space-4) var(--space-5);
    border: var(--border);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .prose :global(blockquote p) {
    color: var(--color-ink);
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--color-ink);
    background: var(--color-surface);
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: var(--space-4);
    border: var(--border);
    box-shadow: var(--shadow-sm);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .prose :global(a) {
    color: var(--color-ink);
    text-decoration-color: var(--color-blue);
  }

  .prose :global(hr) {
    border: 0;
    border-top: var(--border);
  }

  .prose :global(img) {
    border: var(--border);
  }
</style>
