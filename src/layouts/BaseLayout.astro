---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import { SITE } from '../config/site';
import '../styles/global.css';

// title, description, image, imageAlt, article and noindex all go to <Seo />.
type Props = SeoProps;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...Astro.props} />
    <meta name="theme-color" content="#f5efe0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />
    <!-- Flags JS before first paint so scroll-reveal's hidden state never flashes. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link mono" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <!-- Motion #5 scroll reveal and #6 marquee offscreen pause. Enhancement only. -->
    <script is:inline>
      (() => {
        const items = [];
        document.querySelectorAll('[data-reveal]').forEach((group) => {
          [...group.children].forEach((el, i) => {
            el.style.setProperty('--i', String(Math.min(i, 6)));
            items.push(el);
          });
        });
        const marquees = document.querySelectorAll('[data-marquee]');
        if (!('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const reveal = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              reveal.unobserve(entry.target);
            });
          },
          { threshold: 0.15 },
        );
        items.forEach((el) => reveal.observe(el));
        const pause = new IntersectionObserver((entries) => {
          entries.forEach((entry) =>
            entry.target.classList.toggle('is-paused', !entry.isIntersecting),
          );
        });
        marquees.forEach((el) => pause.observe(el));
      })();
    </script>
  </body>
</html>
