# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# Copied to dist/ as-is; other static hosts ignore it.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Everything under /_astro/ has a content hash in its filename, so it can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
